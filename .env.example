# Postgres (Neon). DATABASE_URL is the pooled connection for the app,
# DIRECT_URL the unpooled one Prisma uses for migrations.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/rota?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/rota?sslmode=verify-full"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (see docs/setup.md)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The allowlist. Only these Google accounts can sign in.
ROTA_ALLOWED_EMAILS="rob@example.com,hannah@example.com"
